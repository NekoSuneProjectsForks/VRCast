# Generate with: pwsh -NoProfile -Command "[Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))"
VRCAST_SESSION_ADMIN_TOKEN=REPLACE_WITH_48_OR_MORE_RANDOM_CHARACTERS
VRCAST_SESSION_PUBLISH_ADDRESS=127.0.0.1
VRCAST_SESSION_PORT=39580
VRCAST_SESSION_MAX_ROOMS=100
VRCAST_SESSION_MAX_PARTICIPANTS=16
VRCAST_SESSION_RATE_LIMIT=60
